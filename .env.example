# Porta HTTP do servidor MCP
PORT=8787

# URL base do portal (raramente precisa mudar)
VPSISTEMA_URL=https://vpsistema.com

# Credenciais da conta de SERVIÇO dedicada (nível Administrador), criada
# via vpsistema.com/admin → "+ Convidar". Nunca use uma conta pessoal.
VPSISTEMA_EMAIL=
VPSISTEMA_PASSWORD=

# Domínios que o browser tem permissão de navegar/abrir, mesmo autenticado.
# Qualquer navegação (vp_navigate, ou um card cuja URL saia daqui) é bloqueada.
ALLOWED_DOMAINS=vpsistema.com,verticalparts.com

# Token opcional exigido no header "Authorization: Bearer <token>" em toda
# chamada ao /mcp. Sem isso, quem descobrir a URL do servidor controla uma
# sessão logada como Administrador em todos os sistemas internos da VP.
# Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=

# false para rodar com janela visível (debug local apenas)
HEADLESS=true

# Só necessário se o Chromium do Playwright não estiver no caminho padrão
# do cache (ex.: imagem Docker com browser pré-instalado em outro lugar)
PLAYWRIGHT_EXECUTABLE_PATH=

# Onde persistir a sessão do browser (cookies/localStorage) entre restarts,
# para não precisar logar toda vez que o processo reinicia.
STORAGE_STATE_PATH=./.data/storage-state.json
